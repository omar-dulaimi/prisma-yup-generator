{
  "name": "prisma-yup-generator",
  "version": "1.0.0",
  "description": "Prisma +2 generator to emit Yup schemas from your Prisma schema",
  "repository": "https://github.com/omar-dulaimi/prisma-yup-generator",
  "bin": {
    "prisma-yup-generator": "lib/generator.js"
  },
  "scripts": {
    "gen-example": "tsc && npx prisma generate",
    "package": "./package.sh",
    "package:publish": "./package.sh && cd package && npm publish",
    "release": "semantic-release"
  },
  "author": {
    "name": "Omar Dulaimi",
    "url": "https://github.com/omar-dulaimi"
  },
  "keywords": [
    "prisma",
    "prisma-client",
    "prisma-schema",
    "yup",
    "prisma-generator",
    "prisma-yup-generator"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^4.0.0",
    "@prisma/generator-helper": "^4.0.0",
    "@prisma/internals": "^4.0.0",
    "prettier": "^2.7.1",
    "tslib": "^2.4.0",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^18.0.3",
    "@types/prettier": "^2.6.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "prisma": "^4.0.0",
    "semantic-release": "^25.0.8",
    "typescript": "^4.7.4"
  },
  "bugs": {
    "url": "https://github.com/omar-dulaimi/prisma-yup-generator/issues"
  },
  "homepage": "https://github.com/omar-dulaimi/prisma-yup-generator#readme",
  "private": true
}
