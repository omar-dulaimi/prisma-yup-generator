{
  "branches": ["master"],
  "//": "Set explicitly. Left to package.json, @semantic-release/github can parse the repository field into an empty $owner, and its `fail` step then dies with an invalid-value GraphQL error that masks the real failure.",
  "repositoryUrl": "https://github.com/omar-dulaimi/prisma-yup-generator.git",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "docs", "release": false },
          { "type": "style", "release": false },
          { "type": "chore", "release": false },
          { "type": "test", "release": false },
          { "type": "build", "release": false },
          { "type": "ci", "release": false },
          { "scope": "breaking", "release": "major" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "🚀 Features" },
            { "type": "fix", "section": "🐛 Bug Fixes" },
            { "type": "perf", "section": "⚡ Performance Improvements" },
            { "type": "revert", "section": "⏪ Reverts" },
            { "type": "refactor", "section": "♻️ Code Refactoring" },
            { "type": "docs", "section": "📚 Documentation", "hidden": false },
            { "type": "style", "section": "💄 Styles", "hidden": true },
            { "type": "chore", "section": "🔧 Miscellaneous Chores", "hidden": true },
            { "type": "test", "section": "✅ Tests", "hidden": true },
            { "type": "build", "section": "🏗️ Build System", "hidden": true },
            { "type": "ci", "section": "👷 CI/CD", "hidden": true }
          ]
        }
      }
    ],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/npm",
      {
        "//": "Bumps the repo root only. package.sh copies the root package.json into package/, so if the root version were never written the published version and the version a reader sees here would drift apart. Publishes nothing: the root is `private: true` and npmPublish is off.",
        "npmPublish": false,
        "pkgRoot": "."
      }
    ],
    [
      "@semantic-release/npm",
      {
        "//": "The real publish. This project ships a curated directory built by package.sh, not the repo root, so pkgRoot points there. The release workflow must run `npm run package` before semantic-release, otherwise this plugin cannot find a package.json and fails during verifyConditions.",
        "pkgRoot": "package"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "package-lock.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": "🎉 Released in [v${nextRelease.version}](https://www.npmjs.com/package/prisma-yup-generator/v/${nextRelease.version}).",
        "//": "No failure issue: the workflow run already reports the failure, and the fail step's own GraphQL call has a history of erroring and masking the real cause.",
        "failComment": false,
        "failTitle": false,
        "labels": ["released"]
      }
    ]
  ]
}
